{
  "manifest_version": 3,
  "name": "Maps Lead Scraper - Business Extractor",
  "version": "1.0.0",
  "description": "Ekstrak kontak bisnis, nomor telepon, direct WhatsApp link, website, dan alamat dari Google Maps ke format CSV/Excel.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/maps/*",
    "*://www.google.co.id/maps/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/maps/*",
        "*://www.google.co.id/maps/*"
      ],
      "js": [
        "lib/parser.js",
        "lib/exporter.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
